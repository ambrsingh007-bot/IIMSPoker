# Set these as server-side environment variables in Netlify.
# Never commit real credentials or expose secret keys to browser JavaScript.
SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
SUPABASE_SECRET_KEY=sb_secret_REPLACE_ME
# Optional compatibility for projects using the legacy key:
# SUPABASE_SERVICE_ROLE_KEY=YOUR_LEGACY_SERVICE_ROLE_KEY
CLUB_PIN=REPLACE_WITH_A_RANDOM_SECRET_AT_LEAST_8_CHARACTERS
